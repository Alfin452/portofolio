# ==========================================
# VIRTUAL AI OFFICE - ENVIRONMENT CONFIG
# ==========================================

# --- Google Gemini API Configuration ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- Kantor Agent 3D Visualizer Configuration ---
KANTOR_PORT=8788
KANTOR_BIND=127.0.0.1
KANTOR_RUNTIME=node
KANTOR_AUTOSTART=0

# --- Portfolio Application Environment (Laravel) ---
APP_NAME="Finn Portfolio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

